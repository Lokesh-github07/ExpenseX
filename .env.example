# Copy to .env and fill in. Save the file with LF line endings (not CRLF).
DB_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Gmail SMTP - needs 2-Step Verification ON, then an App Password
# from https://myaccount.google.com/apppasswords (16 characters)
MAIL_USERNAME=your_gmail@gmail.com
MAIL_APP_PASSWORD=abcdefghijklmnop

# Set to false to just print emails in the console (no SMTP)
MAIL_ENABLED=true

FINANCIAL_API_KEY=your_fred_api_key
FINANCIAL_API_BASE_URL=https://api.stlouisfed.org/fred
